{
  "name": "@tide-ota/example-operator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wrangler": "WRANGLER_SEND_METRICS=false WRANGLER_SEND_ERROR_REPORTS=false wrangler",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run wrangler deploy --dry-run --env staging && pnpm run wrangler deploy --dry-run --env production",
    "test": "vitest run"
  },
  "dependencies": {
    "@tide-ota/server": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
