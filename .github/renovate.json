{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "TypeScript moves with oxlint-tsgolint, which embeds it.",
      "groupName": "oxc toolchain and TypeScript",
      "matchPackageNames": ["oxlint", "oxfmt", "oxlint-tsgolint", "typescript"]
    },
    {
      "description": "Run `pnpm -F @tide/server types` after a bump; the gate checks the generated types.",
      "groupName": "Cloudflare",
      "matchPackageNames": ["wrangler", "@cloudflare/**"]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    }
  ]
}
