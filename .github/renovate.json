{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "TypeScript moves with oxlint-tsgolint, which embeds it.",
      "groupName": "oxc toolchain and TypeScript",
      "matchPackageNames": ["oxlint", "oxfmt", "oxlint-tsgolint", "typescript"]
    },
    {
      "description": "Run `pnpm -F @tide-ota/server types` after a bump; the gate checks the generated types.",
      "groupName": "Cloudflare",
      "matchPackageNames": ["wrangler", "@cloudflare/**"]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Each conformance app stays on its Expo SDK, which pins React Native and React: patch updates only. A new SDK gets its own app directory.",
      "matchFileNames": ["conformance/apps/**"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "groupName": "conformance app SDK 55",
      "matchFileNames": ["conformance/apps/sdk-55/**"]
    },
    {
      "groupName": "conformance app SDK 58",
      "matchFileNames": ["conformance/apps/sdk-58/**"]
    }
  ]
}
