{
  "name": "@tide-ota/server",
  "version": "0.0.0",
  "description": "Self-hosted Expo Updates server for React Native OTA updates, on Cloudflare Workers (R2) or Node (S3). No database.",
  "keywords": [
    "expo",
    "expo-updates",
    "expo-updates-server",
    "eas-update",
    "react-native",
    "react-native-ota",
    "ota",
    "ota-updates",
    "self-hosted",
    "codepush-alternative",
    "cloudflare-workers",
    "r2",
    "s3",
    "serverless"
  ],
  "homepage": "https://github.com/HashimTheArab/tide/blob/main/docs/deploy.md",
  "bugs": {
    "url": "https://github.com/HashimTheArab/tide/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HashimTheArab/tide.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "exports": {
    "./workers": "./src/workers.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "exports": {
      "./workers": "./dist/workers.js",
      "./node": "./dist/node.js"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.workers.json && tsc -p tsconfig.build.node.json",
    "prepack": "pnpm run build",
    "wrangler": "WRANGLER_SEND_METRICS=false WRANGLER_SEND_ERROR_REPORTS=false wrangler",
    "dev:workers": "pnpm run wrangler dev",
    "dev:node": "node src/node.ts",
    "types": "pnpm run wrangler types --strict-vars=false",
    "typecheck": "pnpm run types --check && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.workers.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@tide-ota/protocol": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "yaml": "2.9.1"
  }
}
