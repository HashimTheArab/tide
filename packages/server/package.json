{
  "name": "@tide-ota/server",
  "version": "0.0.0",
  "description": "Read-only Expo Updates server for Cloudflare Workers with R2, or Node with S3-compatible or disk storage.",
  "keywords": [
    "expo",
    "expo-updates",
    "over-the-air",
    "ota",
    "react-native",
    "cloudflare-workers",
    "hono",
    "r2",
    "s3"
  ],
  "homepage": "https://github.com/HashimTheArab/tide#readme",
  "bugs": {
    "url": "https://github.com/HashimTheArab/tide/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HashimTheArab/tide.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    "./workers": "./src/workers.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "exports": {
      "./workers": {
        "types": "./dist/workers.d.ts",
        "default": "./dist/workers.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.workers.json && tsc -p tsconfig.build.node.json",
    "prepack": "pnpm run build",
    "wrangler": "WRANGLER_SEND_METRICS=false WRANGLER_SEND_ERROR_REPORTS=false wrangler",
    "dev:workers": "pnpm run wrangler dev",
    "dev:node": "node src/node.ts",
    "types": "pnpm run wrangler types --strict-vars=false",
    "typecheck": "pnpm run types --check && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.workers.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@tide-ota/protocol": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "yaml": "2.9.1"
  }
}
