{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tide",
  "main": "src/workers.ts",
  "compatibility_date": "2026-11-01",
  // A binding cannot be read-only; the Worker only calls get (see docs/design.md, Storage).
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tide" }],
  // When set, a request whose expo-app-id is present and differs is rejected; empty means unset.
  "vars": { "TIDE_APP_ID": "" },
}
