{
  "name": "@tide-ota/protocol",
  "version": "0.0.0",
  "description": "Expo Updates protocol v1 on web-standard APIs: manifests, multipart replies, code signing and bsdiff patches.",
  "keywords": [
    "expo-updates",
    "expo-updates-protocol",
    "manifest",
    "code-signing",
    "multipart",
    "bsdiff",
    "bspatch",
    "web-crypto"
  ],
  "homepage": "https://github.com/HashimTheArab/tide/blob/main/docs/design.md",
  "bugs": {
    "url": "https://github.com/HashimTheArab/tide/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HashimTheArab/tide.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
