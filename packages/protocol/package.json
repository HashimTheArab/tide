{
  "name": "@tide-ota/protocol",
  "version": "0.0.0",
  "description": "Expo Updates protocol v1 manifests, multipart bodies, signatures and bsdiff patches, on web-standard APIs.",
  "keywords": [
    "expo",
    "expo-updates",
    "over-the-air",
    "ota",
    "react-native",
    "code-signing",
    "multipart",
    "bsdiff"
  ],
  "homepage": "https://github.com/HashimTheArab/tide#readme",
  "bugs": {
    "url": "https://github.com/HashimTheArab/tide/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HashimTheArab/tide.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
