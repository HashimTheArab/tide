{
  // No Node types: Buffer and process do not compile here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "WebWorker"],
    "types": [],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.web.json"
  },
  "include": ["src", "test"],
  // The generator and its test run on Node only.
  "exclude": ["test/generate-fixtures.ts", "test/generate-fixtures.test.ts"]
}
