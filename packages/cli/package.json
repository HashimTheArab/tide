{
  "name": "@tide-ota/cli",
  "version": "0.0.0",
  "description": "Tide CLI: export, sign and publish Expo updates, register builds for bundle diffing, roll back and inspect storage.",
  "keywords": [
    "expo",
    "expo-updates",
    "over-the-air",
    "ota",
    "react-native",
    "cli",
    "code-signing",
    "bsdiff"
  ],
  "homepage": "https://github.com/HashimTheArab/tide#readme",
  "bugs": {
    "url": "https://github.com/HashimTheArab/tide/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HashimTheArab/tide.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "tide": "./src/main.ts"
  },
  "publishConfig": {
    "bin": {
      "tide": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:container": "vitest run --config vitest.container.config.ts"
  },
  "dependencies": {
    "@tide-ota/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
