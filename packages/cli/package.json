{
  "name": "@tide-ota/cli",
  "version": "0.0.0",
  "description": "Publish signed Expo OTA updates to your own R2 or S3 bucket, with bundle diffing, rollbacks and AWS KMS signing.",
  "keywords": [
    "expo",
    "expo-updates",
    "eas-update",
    "react-native",
    "react-native-ota",
    "ota",
    "ota-updates",
    "self-hosted",
    "publish",
    "code-signing",
    "rollback",
    "aws-kms",
    "bsdiff"
  ],
  "homepage": "https://github.com/HashimTheArab/tide/blob/main/docs/getting-started.md#3-publish-an-update",
  "bugs": {
    "url": "https://github.com/HashimTheArab/tide/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HashimTheArab/tide.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "bin": {
    "tide": "./src/main.ts"
  },
  "publishConfig": {
    "bin": {
      "tide": "./dist/main.js"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:container": "vitest run --config vitest.container.config.ts"
  },
  "dependencies": {
    "@tide-ota/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
