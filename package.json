{
  "name": "tide-monorepo",
  "private": true,
  "description": "A serverless Expo Updates server for Cloudflare Workers or any container.",
  "keywords": [
    "expo",
    "expo-updates",
    "over-the-air",
    "ota",
    "react-native",
    "cloudflare-workers",
    "code-signing",
    "bsdiff"
  ],
  "homepage": "https://github.com/HashimTheArab/tide#readme",
  "bugs": {
    "url": "https://github.com/HashimTheArab/tide/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HashimTheArab/tide.git"
  },
  "type": "module",
  "engines": {
    "node": "^26.13.1",
    "pnpm": "^12.21.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint packages examples scripts conformance",
    "lint:fix": "oxlint --fix packages examples scripts conformance",
    "lint:ws": "sherif",
    "postinstall": "pnpm lint:ws",
    "format": "oxfmt --check packages examples scripts conformance",
    "format:fix": "oxfmt packages examples scripts conformance",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:container": "pnpm -F @tide-ota/cli test:container",
    "test:pack": "node scripts/pack.test.mjs",
    "build": "pnpm -r build",
    "knip": "knip --no-config-hints",
    "docs:check": "node scripts/check-docs.mjs",
    "gate": "node scripts/gate.mjs",
    "conformance": "node conformance/src/main.ts",
    "hermes-delta": "node conformance/src/hermes-delta/main.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "6.45.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "sherif": "1.13.0",
    "typescript": "catalog:"
  }
}
