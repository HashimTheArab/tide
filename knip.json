{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".claude/workflows/**",
    "conformance/apps/**"
  ],
  "ignoreBinaries": [
    "mkfifo"
  ],
  "workspaces": {
    "packages/protocol": {
      "entry": [
        "test/generate-fixtures.ts",
        "test/generate-patch-fixtures.ts"
      ],
      "ignoreBinaries": [
        "bzip2"
      ]
    },
    "packages/cli": {
      "entry": [
        "src/main.ts",
        "test/disk-writer.ts",
        "test/fake-expo.ts",
        "test/open-writer.ts"
      ]
    },
    "conformance": {
      "entry": [
        "src/main.ts",
        "src/hermes-delta/main.ts",
        "test/fake-android.ts",
        "test/hold-stack.ts",
        "test/hung-export.ts",
        "test/leave-worker.ts"
      ]
    }
  }
}
