        "-O"
      ],
      "hermescTempDir": "<tmpdir>/expo-bundler-<Math.random()>-<Date.now()>, removed after the compile",
      "reproducesExport": true,
      "bytesDependOnTempPath": true,
      "noBytecodeJsIsHermescInput": false,
      "noBytecodeJsBytes": 1097413,
      "hermescInputBytes": 2681587,
      "serializer": {
        "compile": "@expo/metro-config/build/serializer/exportHermes.js buildHermesBundleAsync",
        "callers": [
          "@expo/metro-config/build/serializer/serializeChunks.js"
        ],
        "bytecodeGate": [
          "@expo/metro-config/build/serializer/serializeChunks.js"
        ]
      },
      "hook": "@expo/metro-config/build/serializer/exportHermes.js buildHermesBundleAsync passes hermesc no caller arguments, so -base-bytecode needs one of two seams: a hermesc under REACT_NATIVE_OVERRIDE_HERMES_DIR that appends it (how this study captures each compile), or expo export --no-bytecode followed by Tide's own hermesc run with Expo's flags on the JS bundle it writes; the --no-bytecode JS differs from what Expo compiles"
    },
    "embedded": {
