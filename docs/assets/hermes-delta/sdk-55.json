{
  "schema": 3,
  "about": "Android bundles. Bases: the embedded bundle and an OTA export of the app's start tree, and an OTA export one update later (the OTA base); each change is a patch onto that update. Plain bundles are expo export's hermesc command recompiled on fixed relative names; delta bundles add -base-bytecode. Steady bases compile the OTA base's and the older OTA update's JS against the embedded bundle.",
  "keepRule": "Tide stores a patch only when its bytes times two are at most the gzip-9 size of the new bundle (packages/cli/src/publish-patch.ts keepsPatch)",
  "bases": {
    "ota": "the previous OTA update (the OTA compile base)",
    "embedded": "the bundle the release build embeds (the embedded compile base)",
    "older-ota": "an OTA update one release older, from the embedded build's source"
  },
  "steadyBases": {
    "ota": "the previous OTA update, itself delta-compiled against the embedded base",
    "older-ota": "the older OTA update, itself delta-compiled against the embedded base"
  },
  "targets": {
    "plain": "what expo export writes",
    "delta-ota": "the same JS and flags, plus -base-bytecode of the OTA base",
    "delta-embedded": "the same JS and flags, plus -base-bytecode of the embedded base"
  },
