{
  "schema": 1,
  "about": "Android bundles. Bases: the embedded bundle and an OTA export of each app's start tree, and an OTA export one update later (the OTA base); each change is a patch onto that update. Plain bundles are expo export's hermesc command recompiled at a fixed path; delta bundles add -base-bytecode.",
  "keepRule": "Tide stores a patch only when its bytes times two are at most the gzip-9 size of the new bundle (packages/cli/src/publish-patch.ts preparePatches)",
  "bases": {
    "ota": "the previous OTA update (the OTA compile base)",
    "embedded": "the bundle the release build embeds (the embedded compile base)",
    "older-ota": "an OTA update one release older, from the embedded build's source"
  },
  "targets": {
    "plain": "what expo export writes",
    "delta-ota": "the same JS and flags, plus -base-bytecode of the OTA base",
    "delta-embedded": "the same JS and flags, plus -base-bytecode of the embedded base"
  },
