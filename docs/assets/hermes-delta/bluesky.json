        "release": "260318099.0.5",
        "bytecodeVersion": 99
      }
    },
    "export": {
      "command": [
        "expo",
        "export",
        "--output-dir",
        "<dir>",
        "--platform",
        "android"
      ],
      "env": {
        "EXPO_NO_DOTENV": "1",
        "NODE_ENV": "production",
        "BABEL_ENV": "production",
        "EXPO_PUBLIC_ENV": "production"
      },
      "hermescArgs": [
        "-emit-binary",
        "-out",
        "<tmp>/index.hbc",
        "<tmp>/index.js",
        "-O"
      ],
      "hermescTempDir": "<tmpdir>/expo-bundler-<Math.random()>-<Date.now()>, removed after the compile",
      "reproducesExport": true,
      "bytesDependOnTempPath": true,
      "noBytecodeJsIsHermescInput": false,
      "noBytecodeJsBytes": 33516212,
      "hermescInputBytes": 53646765,
      "serializer": {
        "compile": "@expo/metro-config/build/serializer/exportHermes.js buildHermesBundleAsync",
        "callers": [
          "@expo/metro-config/build/serializer/hermesArtifacts.js",
          "@expo/metro-config/build/serializer/chunking/Chunk.js"
        ],
        "bytecodeGate": [
          "@expo/metro-config/build/serializer/chunking/Chunk.js"
        ]
      },
      "hook": "@expo/metro-config/build/serializer/exportHermes.js buildHermesBundleAsync passes hermesc no caller arguments, so -base-bytecode needs one of two seams: a hermesc under REACT_NATIVE_OVERRIDE_HERMES_DIR that appends it (how this study captures each compile), or expo export --no-bytecode followed by Tide's own hermesc run with Expo's flags on the JS bundle it writes; the --no-bytecode JS differs from what Expo compiles"
    },
    "embedded": {
      "bundleCommand": [
        "node",
        "node_modules/@expo/cli/build/src/index.js",
        "export:embed",
        "--platform",
        "android",
        "--dev",
        "false",
        "--reset-cache",
        "--entry-file",
        "index.ts",
        "--bundle-output",
        "android/app/build/generated/assets/react/release/index.android.bundle",
        "--assets-dest",
        "android/app/build/generated/res/react/release",
        "--sourcemap-output",
        "android/app/build/intermediates/sourcemaps/react/release/index.android.bundle.packager.map",
        "--minify",
        "false",
        "--verbose"
      ],
      "hermescArgs": [
        "-w",
        "-emit-binary",
        "-max-diagnostic-width=80",
        "-out",
        "android/app/build/generated/assets/react/release/index.android.bundle.hbc",
        "android/app/build/generated/assets/react/release/index.android.bundle",
        "-O",
        "-output-source-map"
      ],
      "flagsFrom": [
        "node_modules/@react-native/gradle-plugin/react-native-gradle-plugin/src/main/kotlin/com/facebook/react/tasks/BundleHermesCTask.kt getHermescCommand",
        "node_modules/@react-native/gradle-plugin/react-native-gradle-plugin/src/main/kotlin/com/facebook/react/ReactExtension.kt hermesFlags convention",
        "expo/template.tgz android/app/build.gradle react { bundleCommand } (no hermesFlags)"
      ]
    },
    "delta": {
      "hermescArgs": [
        "-emit-binary",
        "-out",
        "index.hbc",
        "index.js",
        "-O",
        "-base-bytecode=base.hbc"
      ]
    },
