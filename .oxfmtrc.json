{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/worker-configuration.d.ts",
    "packages/protocol/test/fixtures/**",
    "packages/cli/test/fixtures/**",
    "conformance/apps/*/package-lock.json"
  ],
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "type-tide",
        "selector": "type",
        "elementNamePattern": [
          "@tide-ota/**"
        ]
      },
      {
        "groupName": "tide",
        "elementNamePattern": [
          "@tide-ota/**"
        ]
      }
    ],
    "groups": [
      "side_effect",
      {
        "newlinesBetween": true
      },
      "builtin",
      [
        "type-builtin",
        "type-external"
      ],
      [
        "external",
        "unknown"
      ],
      {
        "newlinesBetween": true
      },
      "type-tide",
      "tide",
      {
        "newlinesBetween": true
      },
      [
        "type-internal",
        "type-parent",
        "type-sibling",
        "type-index"
      ],
      "internal",
      [
        "parent",
        "sibling",
        "index"
      ]
    ]
  }
}
